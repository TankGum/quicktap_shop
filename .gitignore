.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python bytecode của scripts/skill
__pycache__/

# Cấu hình wrangler ở GỐC repo — chỉ dùng lúc chạy thử ở máy, KHÔNG BAO GIỜ commit.
